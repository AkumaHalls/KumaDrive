# KumaDrive desktop app — environment variables.
# Copy to `.env` and uncomment/edit values as needed.
# Variables prefixed with `VITE_` are exposed to the client bundle by Vite.

# Base URL of the kumadrive-backend service (optional).
# KumaDrive is a backend-less app: storage happens entirely over Telegram,
# so this is only needed if you run an auxiliary service alongside the client.
# Dev:   http://localhost:3000
# Prod:  https://your-deployment.example.com
VITE_API_BASE_URL=http://localhost:3000

<script>
try {
window._customJS = function (_root) {
  var root = _root || document;
  var bar = root.querySelector('[data-region]');
  if (!bar) return;

  var toggle = root.querySelector('#custom-expand');

  /* No click handlers here -- .send-btn + data-url is what floating-unit.js binds.
     floating-unit owns .expanded on the bar; mirror it onto aria-expanded rather than
     toggling it ourselves (a second toggle would cancel its own and the caret would
     never move). Caret and panel are driven from .expanded in _adobecx.scss. */
  function sync() {
    var open = bar.classList.contains('expanded');
    if (toggle) toggle.setAttribute('aria-expanded', String(open));

    /* the panel is fetched lazily, so re-query the video each time rather than
       caching it -- childList below fires when the panel is inserted */
    var video = bar.querySelector('.acx-video');
    if (!video) return;
    video.muted = true;               /* autoplay requires muted */
    if (open) {
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
    } else if (!video.paused) {
      video.pause();
    }
  }
  new MutationObserver(sync).observe(bar, {
    attributes: true,
    attributeFilter: ['class'],
    childList: true,
    subtree: true
  });
  sync();

  /* Esc closes the panel -- floating-unit has click-outside but no key handling */
  root.addEventListener('keydown', function (e) {
    if ((e.key === 'Escape' || e.key === 'Esc') && toggle && bar.classList.contains('expanded')) {
      toggle.dispatchEvent(new MouseEvent('mousedown', {bubbles: true}));
      toggle.focus();
    }
  });
};

(function() {
    window._customJS(null);
})();
}catch(e){ console.log("err", e)};
</script>




    

            
    

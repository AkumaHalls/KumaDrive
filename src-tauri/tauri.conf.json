{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KumaDrive",
  "mainBinaryName": "KumaDrive",
  "version": "0.1.0",
  "identifier": "com.kumadrive.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "KumaDrive",
        "title": "KumaDrive",
        "width": 1200,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "dragDropEnabled": false,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "contentProtected": false,
        "focus": true,
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: localhost: http://localhost:1420 http://127.0.0.1:1420; script-src 'self' 'unsafe-eval' 'unsafe-inline' localhost: https://checkout.razorpay.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://*.telegram.org; media-src 'self' blob: data: https://*.telegram.org; connect-src 'self' wss://*.telegram.org https://*.telegram.org ws://localhost:1420 ws://127.0.0.1:1420 http://localhost:1420 http://127.0.0.1:1420 http://localhost:3000 http://127.0.0.1:3000 https://api.razorpay.com https://lumberjack.razorpay.com;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 KumaDrive. Todos os direitos reservados.",
    "category": "Utility",
    "shortDescription": "Armazenamento em nuvem ilimitado, gratuito e privado usando o Telegram",
    "longDescription": "KumaDrive é um cliente de armazenamento em nuvem multiplataforma moderno que utiliza canais privados do Telegram como backend de armazenamento. Zero custo de servidor, zero assinaturas, criptografia MTProto direta para o Telegram.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "nsis": {
        "languages": ["Portuguese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-common",
          "xdg-utils"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libayatana-appindicator-gtk3",
          "librsvg2",
          "xdg-utils"
        ]
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/AkumaHalls/KumaDrive/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5MERGNjE5NzY5MUE0NDQKUldSRXBKRjJHZllOYVdybG9FQ3NDL2FXWW0wTzg5OXFReVMxQ3l5Y2x1T1QrTDM0WnBka3MraTEK",
      "windows": {
        "installMode": "passive"
      }
    },
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}